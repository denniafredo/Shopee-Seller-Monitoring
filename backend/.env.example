PORT=3000

# Sandbox/Test Stable:
SHOPEE_HOST="https://partner.test-stable.shopeemobile.com"

# Production:
# SHOPEE_HOST="https://partner.shopeemobile.com"

SHOPEE_PARTNER_ID="ISI_PARTNER_ID"
SHOPEE_PARTNER_KEY="ISI_PARTNER_KEY"
SHOPEE_REDIRECT_URL="http://localhost:3000/api/shopee/auth/callback"

SHOPEE_SHOP_ID="ISI_SHOP_ID"
SHOPEE_ACCESS_TOKEN="ISI_ACCESS_TOKEN"
SHOPEE_REFRESH_TOKEN="ISI_REFRESH_TOKEN"

# ===== BCA QRIS Settlement (qr.klikbca.com) =====
MERCH_USERNAME="ISI_MERCHANT_USERNAME"
MERCH_PASSWORD="ISI_MERCHANT_PASSWORD"
QRIS_MID=004047768
QRIS_LOGIN_URL=https://qr.klikbca.com/login
QRIS_HOME_URL=https://qr.klikbca.com/home
QRIS_REFRESH_INTERVAL_MS=3600000
PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
QRIS_HEADLESS=true

QRIS_KEEP_BROWSER=false
# Di EC2 Linux, set path ke chromium/chrome, contoh:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# Skip scrape kalau sisa disk < nilai ini (MB). 0 = matikan cek.
QRIS_MIN_FREE_DISK_MB=800
